# GEMINI_API_KEY: No longer used. This app does not read a server-side
# GEMINI_API_KEY - every user must add their own key from the in-app Settings
# panel, which is sent per-request instead of relying on a shared/integrated key.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
